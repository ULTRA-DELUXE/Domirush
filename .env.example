# Server-only. Never prefix these with NEXT_PUBLIC_.
# Copy to .env.local after you create the Supabase project.

SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Legacy alias — the server client also reads this if SUPABASE_SECRET_KEY is unset.
# SUPABASE_SERVICE_ROLE_KEY=

# Only needed to apply/inspect the schema via psql (never needed at runtime).
# SUPABASE_DB_PASSWORD=
# Optional override if the project is not in ap-northeast-1:
# SUPABASE_DB_POOLER_HOST=aws-0-ap-northeast-1.pooler.supabase.com
